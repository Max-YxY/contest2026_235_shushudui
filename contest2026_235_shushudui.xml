    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_235_shushudui" name="contest2026_235_shushudui">
    <linkfile src="app/camera_diag" dest="packages/demos/contest2026_235_camera_diag"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_235_board"/>
  </project>
</manifest>
